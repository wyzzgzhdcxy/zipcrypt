<?xml version="1.0" encoding="utf-8"?>
<MsixPackagingToolTemplate
    xmlns="http://schemas.microsoft.com/msix/packaging/msixpackagingtool/template/2022">
    <Settings
        AllowTelemetry="false"
        ApplyACLsToPackageFiles="true"
        GenerateCommandLineFile="true"
        AllowPromptForPassword="false">
    </Settings>
    <Installer
        Path="zipcrypt.exe"
        Arguments=""
        InstallLocation="C:\Program Files\wcj\ZipCrypt">
    </Installer>
    <PackageInformation
        PackageName="ZipCrypt"
        PackageDisplayName="ZipCrypt"
        PublisherName="CN=wcj"
        PublisherDisplayName="wcj"
        Version="0.1.0.0"
        PackageDescription="Fast folder archive encryption">
        <Capabilities>
            <Capability Name="runFullTrust" />
            
        </Capabilities>
        <Applications>
            <Application
                Id="com.wcj.zipcrypt"
                Description="Fast folder archive encryption"
                DisplayName="ZipCrypt"
                ExecutableName="zipcrypt.exe"
                EntryPoint="Windows.FullTrustApplication">
                
            </Application>
        </Applications>
        <Resources>
            <Resource Language="en-us" />
        </Resources>
        <Dependencies>
            <TargetDeviceFamily Name="Windows.Desktop" MinVersion="10.0.17763.0" MaxVersionTested="10.0.19041.0" />
        </Dependencies>
        <Properties>
            <Framework>false</Framework>
            <DisplayName>ZipCrypt</DisplayName>
            <PublisherDisplayName>wcj</PublisherDisplayName>
            <Description>Fast folder archive encryption</Description>
            <Logo>Assets\AppIcon.png</Logo>
        </Properties>
    </PackageInformation>
    <SaveLocation PackagePath="zipcrypt.msix" />
    <PackageIntegrity>
        <CertificatePath></CertificatePath>
    </PackageIntegrity>
</MsixPackagingToolTemplate>
